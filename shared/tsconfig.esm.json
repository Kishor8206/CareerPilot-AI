{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // ESM output consumed by Vite. Bundlers resolve the extensionless relative
    // imports in src/ without trouble; the CommonJS build serves Node.
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "outDir": "dist/esm",
    "declaration": false
  },
  "include": ["src/**/*.ts"]
}
