# ============================================================
# CareerPilot AI - Environment Configuration Example
# Copy to .env and fill in real values. NEVER commit a real .env
# ============================================================

# ---------- General ----------
NODE_ENV=development
APP_NAME=CareerPilot AI

# ---------- Node.js Backend (backend/) ----------
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# MongoDB. Leave blank in development to auto-start an in-memory MongoDB
# (mongodb-memory-server) so the project runs without installing MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017/careerpilot
# Set to true to force the in-memory database even if MONGODB_URI is set.
USE_MEMORY_DB=false

# ---------- Authentication ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_access_token_secret
JWT_REFRESH_SECRET=change_me_refresh_token_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=change_me_cookie_secret
BCRYPT_ROUNDS=12

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---------- Python AI Service ----------
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared secret sent as X-Internal-Key on every Node -> FastAPI call
AI_SERVICE_INTERNAL_KEY=change_me_internal_service_key
AI_SERVICE_TIMEOUT_MS=120000

# ---------- LLM provider abstraction ----------
# openai | azure | ollama | mock
# "mock" is a deterministic, clearly-labelled offline provider for development/demo.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=1200
# Azure-specific
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=

# ---------- Vector database ----------
# chroma | faiss | numpy  (numpy = dependency-free fallback used in dev)
VECTOR_DB_PROVIDER=numpy
VECTOR_DB_PATH=./ai-service/data/vectorstore
EMBEDDING_PROVIDER=hash
# hash = deterministic offline embeddings (no network); sentence-transformers = local model; openai = API

# ---------- Speech / voice-assisted interviews and GD (§11) ----------
# How a spoken answer becomes text.
#
#   none    (default) The browser's Web Speech API does the recognition on the
#           student's device. Audio never reaches our servers at all — only the
#           resulting transcript, which the student can edit before submitting.
#   whisper A server-side fallback (faster-whisper) for browsers without the Web
#           Speech API, e.g. Firefox. Audio is transcribed in memory and is never
#           written to disk or retained; only the transcript is stored.
#
# The frontend negotiates this at runtime via GET /api/v1/speech/status, so a
# browser without the API degrades to the server path, and if neither is
# available it degrades to typing. Voice is always optional: every flow is
# completable by keyboard alone.
SPEECH_PROVIDER=none
# tiny | base | small | medium | large-v3  (only used when SPEECH_PROVIDER=whisper)
SPEECH_MODEL=base
SPEECH_DEVICE=cpu
SPEECH_COMPUTE_TYPE=int8
SPEECH_LANGUAGE=en

# ---------- Fine-tuned ATS model (careerpilot_ats/) ----------
# none              (default) The existing rule-based ATS engine only. Behaviour is unchanged.
# openai_compatible The trained LoRA adapter served by vLLM (or any OpenAI-compatible
#                   server) on a GPU machine. Recommended.
# local             Loaded inside the AI service with transformers + PEFT. Needs a CUDA GPU.
#
# If the model fails, times out or returns invalid output, the rule-based engine
# answers instead and the response says so. The final score is always computed
# in code from the model's component scores, never taken from the model.
ATS_MODEL_PROVIDER=none
ATS_MODEL_ENDPOINT=
ATS_MODEL_NAME=careerpilot-ats
ATS_MODEL_API_KEY=
ATS_MODEL_BASE=Qwen/Qwen3-4B-Instruct-2507
ATS_MODEL_ADAPTER_PATH=
ATS_MODEL_TIMEOUT_S=60
ATS_MODEL_MAX_NEW_TOKENS=900

# ---------- Career roadmap model (careerpilot_career/) ----------
# A SEPARATE model from the ATS model: Qwen3-1.7B, its own adapter and settings.
# none              (default) The rule-based planner produces every plan.
# openai_compatible The trained LoRA adapter served by vLLM on a GPU machine. Recommended.
# local             Loaded inside the AI service with transformers + PEFT. Needs a CUDA GPU.
#
# Model output is validated against the career knowledge base. Anything
# arithmetic or factual that is wrong is corrected, and if the output cannot be
# used the rule-based planner answers instead. The response says which happened.
CAREER_MODEL_PROVIDER=none
CAREER_MODEL_ENDPOINT=
CAREER_MODEL_NAME=careerpilot-career
CAREER_MODEL_API_KEY=
CAREER_MODEL_BASE=Qwen/Qwen3-1.7B
CAREER_MODEL_ADAPTER_PATH=
CAREER_MODEL_TIMEOUT_S=90
CAREER_MODEL_MAX_NEW_TOKENS=3000

# ---------- Learning resources: YouTube Data API v3 (career roadmap) ----------
# Optional. Server-side only; never exposed to the browser. Leave empty to
# disable YouTube retrieval (official documentation and courses still work).
# Create a key in Google Cloud Console and restrict it to "YouTube Data API v3".
YOUTUBE_API_KEY=

# ---------- Object storage ----------
# local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./backend/storage
STORAGE_BUCKET=careerpilot-uploads
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_SIZE_MB=5

# ---------- Real-time ----------
SOCKET_URL=http://localhost:5000
SOCKET_PATH=/socket.io
# Public STUN server for WebRTC; add TURN credentials for production NAT traversal
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# ---------- Code execution sandbox (DSA judge) ----------
# docker   = every submission runs in its own isolated, network-less container
# disabled = code is never run; the API reports that honestly
# Student code is never executed on the API host. See docs/DSA_JUDGE.md.
CODE_EXECUTION_PROVIDER=docker
# Image built from judge/Dockerfile with: npm run judge:build
CODE_RUNNER_IMAGE=careerpilot-judge:1
# Path to the docker CLI if it is not on PATH
DOCKER_BIN=docker
# CPU cores, process limit and parallel sandboxes
CODE_RUNNER_CPUS=1
CODE_RUNNER_PIDS_LIMIT=128
CODE_RUNNER_MAX_CONCURRENT=2

# ---------- Email (abstraction; console transport in dev) ----------
# console | smtp
MAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@careerpilot.ai

# ---------- Observability ----------
LOG_LEVEL=info
LOG_PRETTY=true

# ---------- Demo / research mode ----------
# Enables clearly-labelled demo seed accounts and the mock LLM fallback.
DEMO_MODE=true
# Data retention for uploaded artefacts, in days (privacy policy §30)
DATA_RETENTION_DAYS=365

# ---------- Frontend (frontend/) - only VITE_* vars reach the browser ----------
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
VITE_APP_NAME=CareerPilot AI
VITE_DEMO_MODE=true
